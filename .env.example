# ==============================================================================
# AURA HEALTH CLINIC - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# - Do not commit real production secrets to version control.
# - Copy this file to .env or configure in Render / Vercel dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API SERVER & NETWORK CONFIGURATION
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLINIC_TIMEZONE=Asia/Kolkata

# Allowed CORS Origins (Frontend applications)
PATIENT_APP_ORIGIN=http://localhost:5173
ADMIN_APP_ORIGIN=http://localhost:5174

# ------------------------------------------------------------------------------
# 2. ADMINISTRATIVE AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Minimum 32-character random string for signing JWT tokens
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=24h

# Admin console initial bootstrap credentials
ADMIN_USERNAME=admin@auraclinic.com
ADMIN_PASSWORD=AuraClinicAdmin2026!

# ------------------------------------------------------------------------------
# 3. GOOGLE SHEETS & GOOGLE CALENDAR (DATA STORE)
# ------------------------------------------------------------------------------
# Existing Spreadsheet: "Clinic Booking Database"
GOOGLE_SHEETS_DOCUMENT_NAME="Clinic Booking Database"
GOOGLE_SHEETS_DOCUMENT_ID=your_google_sheets_spreadsheet_id_here

# Existing Calendar: "Clinic Appointments"
GOOGLE_CALENDAR_NAME="Clinic Appointments"
GOOGLE_CALENDAR_ID=primary_or_clinic_appointments_calendar_id@group.calendar.google.com

# ------------------------------------------------------------------------------
# 4. N8N APPOINTMENT AUTOMATION WORKFLOWS
# ------------------------------------------------------------------------------
# Internal token sent in Authorization: Bearer <token> to secure n8n webhooks
N8N_INTERNAL_AUTH_TOKEN=your_secure_internal_n8n_bearer_token

# Main Booking Workflow Webhook URL
N8N_BOOKING_WEBHOOK_URL=https://your-n8n-instance.com/webhook/clinic-appointment-booking

# Cancellation Workflow Webhook URL
N8N_CANCELLATION_WEBHOOK_URL=https://your-n8n-instance.com/webhook/clinic-appointment-cancellation

# Reschedule Workflow Webhook URL
N8N_RESCHEDULE_WEBHOOK_URL=https://your-n8n-instance.com/webhook/clinic-appointment-reschedule

# Availability Lookup Workflow Webhook URL (optional override)
N8N_AVAILABILITY_WEBHOOK_URL=https://your-n8n-instance.com/webhook/clinic-slot-availability

# ------------------------------------------------------------------------------
# 5. GMAIL & NOTIFICATION WORKFLOWS
# ------------------------------------------------------------------------------
# Reminders and confirmations are dispatched via n8n Gmail nodes
CLINIC_NOTIFICATION_EMAIL=care@auraclinic.com
CLINIC_EMERGENCY_HOTLINE=+918041238899
